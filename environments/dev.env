# Development Environment
# Use for local development and early testing
# DO NOT commit real API keys — use placeholder values here

ENVIRONMENT=dev

# OpenAI
OPENAI_API_KEY=sk-dev-replace-with-your-key

# Anthropic
ANTHROPIC_API_KEY=sk-ant-dev-replace-with-your-key

# Azure OpenAI
AZURE_OPENAI_API_KEY=dev-replace-with-your-azure-key
AZURE_OPENAI_API_HOST=https://your-dev-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT_ID=gpt-4o-dev

# Red team provider (used in security_testing/redteam*.yaml)
REDTEAM_PROVIDER=openai:gpt-4o

# Eval settings
FAIL_THRESHOLD=0.7
DEFAULT_REPEAT=1
OUTPUT_DIR=reports/json

# Local OpenAI-compatible API (vLLM / LM Studio / FastAPI)
# Used by configs/json_response.yaml — set to your local server URL
LOCAL_API_URL=http://localhost:8000/v1

# SecureBank internal API (dev environment)
LOAN_API_KEY=dev-replace-with-loan-api-key

# Model configuration — update these when upgrading to a new model version
EVAL_MODEL_PRIMARY=openai:gpt-4o
EVAL_MODEL_SECONDARY=openai:gpt-4o-mini
OPENAI_MODEL_TURBO=openai:gpt-4-turbo
OPENAI_MODEL_LEGACY=openai:gpt-3.5-turbo
CLAUDE_MODEL_PRIMARY=anthropic:claude-3-5-sonnet-20241022
CLAUDE_MODEL_FAST=anthropic:claude-3-haiku-20240307
JUDGE_MODEL=openai:gpt-4o-mini

# Ollama local model names — update if you pull different versions
OLLAMA_MODEL_PRIMARY=ollama:llama3
OLLAMA_MODEL_FAST=ollama:mistral
OLLAMA_MODEL_SMALL=ollama:phi3
LOCAL_JUDGE_MODEL=ollama:llama3

# Red team settings
REDTEAM_NUM_TESTS=5

# Local API key — literal value required by OpenAI client; not a real secret
LOCAL_API_KEY=local

# Local OpenAI-compatible model ID (used by configs/json_response.yaml)
LOCAL_OPENAI_MODEL_ID=openai:local-model

# Eval inference settings — tune per environment to control cost and speed
EVAL_MAX_TOKENS=500
SQL_MAX_TOKENS=300
EVAL_TIMEOUT=30000
LOCAL_EVAL_TIMEOUT=60000
LOCAL_NUM_PREDICT=500
EVAL_CONCURRENCY=5
EVAL_SEED=42

# Quality gate thresholds — adjust per environment if needed
LATENCY_THRESHOLD_MS=10000
SQL_LATENCY_THRESHOLD_MS=8000
COST_THRESHOLD_USD=0.005
SQL_COST_THRESHOLD_USD=0.003
AB_COST_THRESHOLD_USD=0.01

# BERTScore model — distilbert-base-uncased (fast) or roberta-large (accurate)
BERT_MODEL_TYPE=distilbert-base-uncased

# SQL performance test threshold (per-test override — tighter than default SQL latency)
SQL_PERF_LATENCY_MS=5000

# NLP validator thresholds — tune per environment
BERT_SCORE_THRESHOLD=0.85
BLEU_THRESHOLD=0.15
METEOR_THRESHOLD=0.40
ROUGE_THRESHOLD=0.30

# RAG faithfulness validator constants
RAG_FAITHFULNESS_THRESHOLD=0.70
RAG_DEFLECTION_PENALTY=0.3
RAG_HALLUCINATION_PENALTY=0.2
RAG_LOW_COVERAGE_THRESHOLD=0.3
RAG_LOW_COVERAGE_PENALTY=0.2
RAG_SHORT_OUTPUT_PENALTY=0.3
RAG_MIN_WORD_COUNT=10
