{# A/B test, Prompt A (Friendly): configs/ab-test-customer-support.yaml. support_prompt_a = prompts/customer_support_v1.txt (defaultTest.vars). #}
{# The system prompt travels as a system message so every provider receives it (config.systemPrompt is ignored by OpenAI/Anthropic/Ollama). #}
{# Keep every Nunjucks tag/comment on ONE line: promptfoo sends the template unrendered if a tag spans lines. #}
[
  {"role": "system", "content": {{ support_prompt_a | dump }}},
  {"role": "user", "content": {{ question | dump }}}
]
