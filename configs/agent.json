{
  "description": "SecureBank AI Agent – Tool Call, Reasoning, Memory & MCP Eval",
  "metadata": {
    "environment": "{{env.ENVIRONMENT}}"
  },
  "prompts": [
    "file://../prompts/agent_chat.json"
  ],
  "providers": [
    {
      "id": "{{env.CLAUDE_MODEL_PRIMARY}}",
      "label": "Claude (Agent)",
      "config": {
        "temperature": 0,
        "max_tokens": 500,
        "timeout": 30000
      },
      "tools": "file://../schemas/agent_tools.json",
      "max_tool_calls": 5
    }
  ],
  "defaultTest": {
    "vars": {
      "system_prompt": "file://../prompts/agent-system-prompt.txt"
    },
    "options": {
      "provider": "{{env.CLAUDE_MODEL_FAST}}"
    },
    "assert": [
      {
        "type": "latency",
        "threshold": 10000
      },
      {
        "type": "cost",
        "threshold": 0.02
      }
    ]
  },
  "evaluateOptions": {
    "maxConcurrency": 5
  },
  "sharing": false
}